-- ==========================================
-- 1. TABELA: TIPO_USUARIO
-- ==========================================

CREATE TABLE tipo_usuario (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tipo_usuario VARCHAR(30) NOT NULL UNIQUE
);


-- ==========================================
-- 2. TABELA: USUARIOS
-- ==========================================

CREATE TABLE usuarios (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    senha_hash VARCHAR(255) NOT NULL,
    id_tipo_usuario INT NOT NULL,
    data_cadastro DATETIME DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (id_tipo_usuario)
        REFERENCES tipo_usuario(id)
);


-- ==========================================
-- 3. TABELA: DADOS_USUARIOS
-- ==========================================

CREATE TABLE dados_usuarios (
    id INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    telefone VARCHAR(20),

    FOREIGN KEY (id_usuario)
        REFERENCES usuarios(id)
        ON DELETE CASCADE
);


-- ==========================================
-- 4. TABELA: INTERESSADOS
-- ==========================================

CREATE TABLE interessados (
    id INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NOT NULL UNIQUE,
    descricao TEXT,
    status VARCHAR(30) DEFAULT 'Pendente',
    data_cadastro DATETIME DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (id_usuario)
        REFERENCES usuarios(id)
);


-- ==========================================
-- 5. TABELA: ATENDIMENTO
-- ==========================================

CREATE TABLE atendimento (
    id INT AUTO_INCREMENT PRIMARY KEY,
    id_adm INT NOT NULL,
    id_interessado INT NOT NULL,
    status_atendimento VARCHAR(30),
    data_atendimento DATETIME DEFAULT CURRENT_TIMESTAMP,
    resultado TEXT,

    FOREIGN KEY (id_adm)
        REFERENCES usuarios(id),

    FOREIGN KEY (id_interessado)
        REFERENCES interessados(id)
);

